# Vendored everything by default
* linguist-vendored

# Except Python source code files
*.py !linguist-vendored

# Auto detect text files and perform LF normalization
* text=auto

# Exclude data and output files from GitHub language statistics
*.csv linguist-vendored
*.html linguist-vendored
/data/** linguist-vendored
/output/** linguist-vendored
/archive/** linguist-vendored
*.md linguist-vendored
*.txt linguist-vendored
*.png linguist-vendored
